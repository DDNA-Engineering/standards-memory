{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardsforge.dev/contracts/pdf-worker-result.schema.json",
  "title": "StandardsForge private PDF worker result",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "limit_policy", "request_sha256", "source_sha256", "page_count", "encryption_status", "normalization", "pages"],
  "properties": {
    "protocol": {"const": "pdf-extraction-worker/0.1.0"},
    "limit_policy": {"const": "pdf-limits/0.1.0"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "page_count": {"type": "integer", "minimum": 1, "maximum": 5000},
    "encryption_status": {"enum": ["not_encrypted", "empty_password_decrypted_for_extraction"]},
    "normalization": {"const": "unicode_nfc_lf_trim_outer_blank_lines_rstrip_lines"},
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["physical_page", "path", "bytes", "sha256", "content_stream_bytes", "text_characters", "text_layer_status"],
        "properties": {
          "physical_page": {"type": "integer", "minimum": 1, "maximum": 5000},
          "path": {"type": "string", "pattern": "^page-[0-9]{4}\\.txt$"},
          "bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "content_stream_bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
          "text_characters": {"type": "integer", "minimum": 0},
          "text_layer_status": {"enum": ["extracted", "no_text"]}
        }
      }
    }
  }
}
