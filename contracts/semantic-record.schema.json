{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardsforge.dev/contracts/semantic-record.schema.json",
  "title": "StandardsForge reviewed semantic record",
  "description": "Evidence-backed semantic decomposition of exact record text. Source-declared applicability is not project applicability.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_role", "normativity", "statement", "qualifiers", "quantities", "unresolved_issues", "project_applicability"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "content_role": {"enum": ["requirement_candidate", "governing_condition", "exception", "applicability_statement", "definition", "table_header", "table_row", "table_footnote", "note", "prose"]},
    "normativity": {"enum": ["normative", "informative", "mixed", "unclassified"]},
    "statement": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject", "action", "modality", "polarity", "exact_text", "span_indices"],
          "properties": {
            "subject": {"type": "string", "minLength": 1},
            "action": {"type": "string", "minLength": 1},
            "modality": {"enum": ["shall", "must", "should", "may", "will", "other"]},
            "polarity": {"enum": ["affirmative", "negative"]},
            "exact_text": {"type": "string", "minLength": 1},
            "span_indices": {"$ref": "#/$defs/span_indices"}
          }
        }
      ]
    },
    "qualifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "exact_text", "span_indices"],
        "properties": {
          "kind": {"enum": ["condition", "exception", "source_applicability", "test_condition", "acceptance_criterion", "tailoring_instruction"]},
          "exact_text": {"type": "string", "minLength": 1},
          "span_indices": {"$ref": "#/$defs/span_indices"}
        }
      }
    },
    "quantities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["raw", "value", "unit", "tolerance", "span_indices"],
        "properties": {
          "raw": {"type": "string", "minLength": 1},
          "value": {"type": ["string", "null"]},
          "unit": {"type": ["string", "null"]},
          "tolerance": {"type": ["string", "null"]},
          "span_indices": {"$ref": "#/$defs/span_indices"}
        }
      }
    },
    "unresolved_issues": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "project_applicability": {"const": "not_decided"}
  },
  "$defs": {
    "span_indices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Zero-based source-span indices in strictly increasing source order; runtime validation enforces ordering.",
      "items": {"type": "integer", "minimum": 0, "maximum": 63}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"content_role": {"const": "requirement_candidate"}}, "required": ["content_role"]},
      "then": {"properties": {"statement": {"type": "object"}}}
    }
  ]
}
