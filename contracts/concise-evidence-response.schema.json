{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardsforge.invalid/contracts/concise-evidence-response-0.1.0.schema.json",
  "title": "StandardsForge concise evidence response profile concise_evidence_v1",
  "description": "Opt-in source-faithful evidence view. Canonical record IDs and exact text are direct; citations and structural provenance expand through packet-local source, derivation, node, and span references.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "response_profile",
    "retrieval_mode",
    "package",
    "authorization",
    "evidence",
    "relationships",
    "provenance",
    "coverage",
    "limitations",
    "token_measurement",
    "budget"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "operation": {"enum": ["get_clause", "build_context"]},
    "response_profile": {"const": "concise_evidence_v1"},
    "retrieval_mode": {"enum": ["exact_pinned_clause", "exact_pinned_multi_clause"]},
    "package": {"$ref": "#/$defs/package"},
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "package_digest"],
      "properties": {
        "status": {"const": "authorized"},
        "package_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "requested_clause_references": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "derivations", "structure_nodes", "spans"],
      "properties": {
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "derivations": {"type": "array", "items": {"$ref": "#/$defs/derivation"}},
        "structure_nodes": {"type": "array", "items": {"$ref": "#/$defs/structureNode"}},
        "spans": {"type": "array", "items": {"$ref": "#/$defs/span"}}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared",
        "source_interpretation",
        "required_dependencies",
        "database_traversal",
        "response_fit",
        "complete_for_requested_scope",
        "scope_interpretation"
      ],
      "properties": {
        "declared": {"$ref": "#/$defs/declaredCoverage"},
        "source_interpretation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["complete", "status"],
          "properties": {"complete": {"type": "boolean"}, "status": {"type": "string"}}
        },
        "required_dependencies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identification_complete", "identification_status", "retrieval_complete", "retrieval_status"],
          "properties": {
            "identification_complete": {"type": "boolean"},
            "identification_status": {"type": "string"},
            "retrieval_complete": {"type": ["boolean", "null"]},
            "retrieval_status": {"type": "string"}
          }
        },
        "database_traversal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["complete", "status"],
          "properties": {"complete": {"type": ["boolean", "null"]}, "status": {"type": "string"}}
        },
        "response_fit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["complete", "status", "unit"],
          "properties": {"complete": {"type": "boolean"}, "status": {"type": "string"}, "unit": {"const": "bytes"}}
        },
        "complete_for_requested_scope": {"type": "boolean"},
        "scope_interpretation": {"type": "string"}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "token_measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"const": "unavailable"},
        "reason": {"const": "no_local_tokenizer_configured"}
      }
    },
    "budget": {"$ref": "#/$defs/budget"}
  },
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_digest", "pack_id", "document_family_id", "edition_id", "identifier", "revision", "title"],
      "properties": {
        "package_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pack_id": {"type": "string", "minLength": 1},
        "document_family_id": {"type": "string", "minLength": 1},
        "edition_id": {"type": "string", "minLength": 1},
        "identifier": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "path", "sha256", "verified"],
      "properties": {
        "ref": {"type": "string", "pattern": "^s[1-9][0-9]*$"},
        "path": {"type": "string", "pattern": "^sources/"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "text_path": {"type": "string", "pattern": "^sources/.*\\.(txt|md)$"},
        "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "verified": {"const": true, "description": "The source digest, and extracted-text digest when present, were verified in this request."}
      },
      "dependentRequired": {"text_path": ["text_sha256"], "text_sha256": ["text_path"]}
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "method", "review_status"],
      "properties": {
        "ref": {"type": "string", "pattern": "^d[1-9][0-9]*$"},
        "statement_role": {"enum": ["obligation", "governing_note", "informative", "unclassified"]},
        "method": {"type": "string", "minLength": 1},
        "review_status": {"type": "string", "minLength": 1}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "record_id", "kind", "clause_reference", "heading", "text", "citation", "derivation_ref"],
      "properties": {
        "ref": {"type": "string", "pattern": "^e[1-9][0-9]*$"},
        "record_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["document", "section", "clause", "paragraph", "list", "list_item", "table", "table_row", "table_cell", "definition", "note", "figure", "unsupported_region", "page"]},
        "clause_reference": {"type": "string", "minLength": 1},
        "heading": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "citation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_ref", "page", "locator", "quote_sha256", "verified"],
          "properties": {
            "source_ref": {"type": "string", "pattern": "^s[1-9][0-9]*$"},
            "page": {"type": "integer", "minimum": 1},
            "locator": {"type": "string", "minLength": 1},
            "quote_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "verified": {"const": true, "description": "The source and exact quote were verified in this request."},
            "text_start_byte": {"type": "integer", "minimum": 0},
            "text_end_byte": {"type": "integer", "minimum": 1}
          },
          "dependentRequired": {"text_start_byte": ["text_end_byte"], "text_end_byte": ["text_start_byte"]}
        },
        "derivation_ref": {"type": "string", "pattern": "^d[1-9][0-9]*$"},
        "structure_ref": {"type": "string", "pattern": "^n[1-9][0-9]*$"}
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "relationship", "required", "target_status"],
      "properties": {
        "source_ref": {"type": "string", "pattern": "^e[1-9][0-9]*$"},
        "relationship": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "target_status": {"enum": ["resolved", "out_of_scope", "unresolved", "ambiguous"]},
        "target_ref": {"type": "string", "pattern": "^e[1-9][0-9]*$"},
        "target_logical_id": {"type": "string", "minLength": 1},
        "target_locator": {"type": "string", "minLength": 1},
        "candidate_logical_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "derivation_ref": {"type": "string", "pattern": "^d[1-9][0-9]*$"},
        "evidence_span_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^p[1-9][0-9]*$"}}
      },
      "allOf": [
        {"if": {"properties": {"target_status": {"const": "resolved"}}, "required": ["target_status"]}, "then": {"anyOf": [{"required": ["target_ref"]}, {"required": ["target_logical_id"]}]}},
        {"if": {"properties": {"target_status": {"enum": ["out_of_scope", "unresolved"]}}, "required": ["target_status"]}, "then": {"required": ["target_locator"]}},
        {"if": {"properties": {"target_status": {"const": "ambiguous"}}, "required": ["target_status"]}, "then": {"required": ["candidate_logical_ids"]}}
      ]
    },
    "structureNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "record_ref", "logical_id", "content_sha256", "parent_logical_id", "ordinal", "span_refs"],
      "properties": {
        "ref": {"type": "string", "pattern": "^n[1-9][0-9]*$"},
        "record_ref": {"type": "string", "pattern": "^e[1-9][0-9]*$"},
        "logical_id": {"type": "string", "minLength": 1},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "parent_logical_id": {"type": ["string", "null"]},
        "ordinal": {"type": "integer", "minimum": 1},
        "span_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^p[1-9][0-9]*$"}}
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "source_ref", "physical_page", "start_byte", "end_byte", "quote_sha256", "verified"],
      "properties": {
        "ref": {"type": "string", "pattern": "^p[1-9][0-9]*$"},
        "source_ref": {"type": "string", "pattern": "^s[1-9][0-9]*$"},
        "physical_page": {"type": "integer", "minimum": 1},
        "start_byte": {"type": "integer", "minimum": 0},
        "end_byte": {"type": "integer", "minimum": 1},
        "quote_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "verified": {"const": true}
      }
    },
    "declaredCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpus_scope", "edition_composition", "parsed_source_coverage", "dependency_closure", "enumeration_traversal", "output_budget_coverage"],
      "properties": {
        "corpus_scope": {"type": "string"},
        "edition_composition": {"type": "string"},
        "parsed_source_coverage": {"type": "string"},
        "dependency_closure": {"type": "string"},
        "enumeration_traversal": {"type": "string"},
        "output_budget_coverage": {"type": "string"}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "used", "limit"],
      "properties": {
        "kind": {"const": "bytes"},
        "used": {"type": "integer", "minimum": 0},
        "limit": {"type": ["integer", "null"], "minimum": 1}
      }
    }
  }
}
