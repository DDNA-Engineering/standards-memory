{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardsforge.dev/contracts/error-response.schema.json",
  "title": "StandardsForge typed error envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "error"],
  "properties": {
    "ok": {"const": false},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "details": {"type": "object"}
      }
    }
  }
}
