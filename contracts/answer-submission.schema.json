{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardsforge.dev/contracts/answer-submission-0.1.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "submission",
    "submission_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite_sha256",
        "respondent_identity",
        "method",
        "submitted_at",
        "answers"
      ],
      "properties": {
        "suite_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "respondent_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "submitted_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "answers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "text",
              "citations"
            ],
            "properties": {
              "case_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,256}$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32768
              },
              "citations": {
                "type": "array",
                "minItems": 0,
                "maxItems": 32,
                "items": {
                  "$ref": "https://standardsforge.dev/contracts/reference-bindings-0.1.0.schema.json#/$defs/binding/properties/source"
                }
              }
            }
          }
        }
      }
    },
    "submission_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
