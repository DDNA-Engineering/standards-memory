{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "format",
    "packs"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "format": {
      "const": "standardsforge-content-bundle-v1"
    },
    "packs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "package_digest",
          "pack_id",
          "files"
        ],
        "properties": {
          "package_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "pack_id": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 513,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256",
                "bytes"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 536870912
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardsforge.dev/contracts/content-bundle-0.1.0.schema.json",
  "title": "Content-addressed pack bundle 0.1.0"
}
