{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardsforge.dev/contracts/benchmark-run-0.1.0.schema.json",
  "title": "StandardsForge synthetic benchmark run",
  "description": "Raw synthetic benchmark results. Digests and byte counts use canonical UTF-8 JSON with sorted keys, no insignificant whitespace, non-ASCII preserved, and non-finite numbers forbidden. run_content_sha256 covers run only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run", "run_content_sha256"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "run": {"$ref": "#/$defs/run"},
    "run_content_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonEmpty": {"type": "string", "minLength": 1},
    "ratioMetric": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "numerator", "denominator", "value", "unit"],
      "properties": {"status": {"const": "measured"}, "numerator": {"type": "integer", "minimum": 0}, "denominator": {"type": "integer", "minimum": 1}, "value": {"type": "number", "minimum": 0, "maximum": 1}, "unit": {"const": "ratio"}}
    },
    "bytesMetric": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "numerator", "denominator", "value", "unit"],
      "properties": {"status": {"const": "measured"}, "numerator": {"type": "integer", "minimum": 0}, "denominator": {"type": "integer", "minimum": 1}, "value": {"type": "number", "minimum": 0}, "unit": {"const": "bytes_per_sample"}}
    },
    "notMeasuredMetric": {
      "type": "object", "additionalProperties": false, "required": ["status", "reason"],
      "properties": {"status": {"const": "not_measured"}, "reason": {"$ref": "#/$defs/nonEmpty"}}
    },
    "metric": {"oneOf": [{"$ref": "#/$defs/ratioMetric"}, {"$ref": "#/$defs/notMeasuredMetric"}]},
    "sample": {
      "type": "object", "additionalProperties": false,
      "required": ["cache_state", "elapsed_ns", "response_bytes", "response_sha256", "response"],
      "properties": {"cache_state": {"enum": ["service_cache_cold", "immediate_repeat_warm"]}, "elapsed_ns": {"type": "integer", "minimum": 0}, "response_bytes": {"type": "integer", "minimum": 2}, "response_sha256": {"$ref": "#/$defs/digest"}, "response": {"type": "object"}}
    },
    "assertions": {
      "type": "object", "additionalProperties": false,
      "required": ["relevant_expected", "relevant_found", "required_context_expected", "required_context_found", "critical_facts_expected", "critical_facts_found", "wrong_edition_results", "citation_mismatches", "false_complete_results", "forbidden_facts_found", "forbidden_claims_found", "revision_mismatches", "result_count_mismatches", "json_value_mismatches", "response_schema_mismatches", "warm_response_mismatches"],
      "properties": {
        "relevant_expected": {"type": "integer", "minimum": 0}, "relevant_found": {"type": "integer", "minimum": 0},
        "required_context_expected": {"type": "integer", "minimum": 0}, "required_context_found": {"type": "integer", "minimum": 0},
        "critical_facts_expected": {"type": "integer", "minimum": 0}, "critical_facts_found": {"type": "integer", "minimum": 0},
        "wrong_edition_results": {"type": "integer", "minimum": 0}, "citation_mismatches": {"type": "integer", "minimum": 0},
        "false_complete_results": {"type": "integer", "minimum": 0}, "forbidden_facts_found": {"type": "integer", "minimum": 0},
        "forbidden_claims_found": {"type": "integer", "minimum": 0}, "revision_mismatches": {"type": "integer", "minimum": 0},
        "result_count_mismatches": {"type": "integer", "minimum": 0}, "json_value_mismatches": {"type": "integer", "minimum": 0},
        "response_schema_mismatches": {"type": "integer", "minimum": 0}, "warm_response_mismatches": {"type": "integer", "minimum": 0}
      }
    },
    "caseResult": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "dimension", "operation", "passed", "failures", "cold", "warm", "assertions"],
      "properties": {
        "case_id": {"$ref": "#/$defs/nonEmpty"}, "dimension": {"enum": ["discovery", "context", "fidelity", "honesty", "revision"]}, "operation": {"enum": ["resolve_document", "search", "get_clause", "diff_editions"]},
        "passed": {"type": "boolean"}, "failures": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}},
        "cold": {"allOf": [{"$ref": "#/$defs/sample"}, {"properties": {"cache_state": {"const": "service_cache_cold"}}}]},
        "warm": {"allOf": [{"$ref": "#/$defs/sample"}, {"properties": {"cache_state": {"const": "immediate_repeat_warm"}}}]},
        "assertions": {"$ref": "#/$defs/assertions"}
      },
      "allOf": [
        {"if": {"properties": {"passed": {"const": true}}, "required": ["passed"]}, "then": {"properties": {"failures": {"maxItems": 0}}}},
        {"if": {"properties": {"passed": {"const": false}}, "required": ["passed"]}, "then": {"properties": {"failures": {"minItems": 1}}}}
      ]
    },
    "gateCounts": {
      "type": "object", "additionalProperties": false,
      "required": ["failed_cases", "wrong_edition_results", "citation_mismatches", "lost_critical_facts", "missing_required_context", "false_complete_results"],
      "properties": {"failed_cases": {"type": "integer", "minimum": 0}, "wrong_edition_results": {"type": "integer", "minimum": 0}, "citation_mismatches": {"type": "integer", "minimum": 0}, "lost_critical_facts": {"type": "integer", "minimum": 0}, "missing_required_context": {"type": "integer", "minimum": 0}, "false_complete_results": {"type": "integer", "minimum": 0}}
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "started_at", "finished_at", "suite", "qualification_class", "claim_boundary", "runner", "source_identity", "environment", "policy_fingerprint", "observed_source_bindings", "protocol", "case_results", "summary", "release_gate", "metrics", "limitations"],
      "properties": {
        "run_id": {"$ref": "#/$defs/digest"}, "started_at": {"type": "string", "format": "date-time"}, "finished_at": {"type": "string", "format": "date-time"},
        "suite": {"type": "object", "additionalProperties": false, "required": ["suite_id", "suite_version", "suite_sha256"], "properties": {"suite_id": {"$ref": "#/$defs/nonEmpty"}, "suite_version": {"$ref": "#/$defs/nonEmpty"}, "suite_sha256": {"$ref": "#/$defs/digest"}}},
        "qualification_class": {"const": "synthetic_contract_qualification"}, "claim_boundary": {"const": "qualifies_benchmark_harness_and_synthetic_contract_behavior_only"},
        "runner": {"type": "object", "additionalProperties": false, "required": ["name", "version", "sha256"], "properties": {"name": {"const": "standardsforge-benchmark"}, "version": {"$ref": "#/$defs/nonEmpty"}, "sha256": {"$ref": "#/$defs/digest"}}},
        "source_identity": {"type": "object", "additionalProperties": false, "required": ["git_commit", "git_dirty"], "properties": {"git_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}, "git_dirty": {"type": "boolean"}}},
        "environment": {"type": "object", "additionalProperties": false, "required": ["python", "sqlite", "platform", "machine", "processor", "standardsforge_version"], "properties": {"python": {"$ref": "#/$defs/nonEmpty"}, "sqlite": {"$ref": "#/$defs/nonEmpty"}, "platform": {"$ref": "#/$defs/nonEmpty"}, "machine": {"type": "string"}, "processor": {"type": "string"}, "standardsforge_version": {"$ref": "#/$defs/nonEmpty"}}},
        "policy_fingerprint": {"$ref": "#/$defs/digest"},
        "observed_source_bindings": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["binding_id", "package_digest", "pack_id", "edition_id", "representation", "content_class"], "properties": {"binding_id": {"$ref": "#/$defs/nonEmpty"}, "package_digest": {"$ref": "#/$defs/digest"}, "pack_id": {"$ref": "#/$defs/nonEmpty"}, "edition_id": {"$ref": "#/$defs/nonEmpty"}, "representation": {"enum": ["page_text", "derived_structure", "reviewed_structure", "curated_records"]}, "content_class": {"$ref": "#/$defs/nonEmpty"}}}},
        "protocol": {"type": "object", "additionalProperties": false, "required": ["cache_states", "repetitions_per_state", "timer", "network", "tokenizer", "peak_process_resources", "engineer_time"], "properties": {"cache_states": {"const": ["service_cache_cold", "immediate_repeat_warm"]}, "repetitions_per_state": {"const": 1}, "timer": {"const": "time.perf_counter_ns"}, "network": {"const": "denied_during_install_and_cases"}, "tokenizer": {"$ref": "#/$defs/notMeasuredMetric"}, "peak_process_resources": {"$ref": "#/$defs/notMeasuredMetric"}, "engineer_time": {"$ref": "#/$defs/notMeasuredMetric"}}},
        "case_results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/caseResult"}},
        "summary": {"type": "object", "additionalProperties": false, "required": ["overall_passed", "case_count", "passed_count", "failed_count"], "properties": {"overall_passed": {"type": "boolean"}, "case_count": {"type": "integer", "minimum": 1}, "passed_count": {"type": "integer", "minimum": 0}, "failed_count": {"type": "integer", "minimum": 0}}},
        "release_gate": {"type": "object", "additionalProperties": false, "required": ["maximums", "observed", "passed"], "properties": {"maximums": {"allOf": [{"$ref": "#/$defs/gateCounts"}, {"properties": {"failed_cases": {"const": 0}, "wrong_edition_results": {"const": 0}, "citation_mismatches": {"const": 0}, "lost_critical_facts": {"const": 0}, "missing_required_context": {"const": 0}, "false_complete_results": {"const": 0}}}]}, "observed": {"$ref": "#/$defs/gateCounts"}, "passed": {"type": "boolean"}}},
        "metrics": {
          "type": "object", "additionalProperties": false,
          "required": ["case_pass_rate", "discovery_recall_at_k", "required_context_recall", "critical_fact_exact_match", "wrong_edition_rate", "citation_mismatch_rate", "false_complete_rate", "all_case_response_bytes", "real_document_discovery_accuracy", "real_document_semantic_fidelity", "tokenizer_normalized_efficiency", "peak_process_resources", "engineer_time_saved"],
          "properties": {"case_pass_rate": {"$ref": "#/$defs/ratioMetric"}, "discovery_recall_at_k": {"$ref": "#/$defs/metric"}, "required_context_recall": {"$ref": "#/$defs/metric"}, "critical_fact_exact_match": {"$ref": "#/$defs/metric"}, "wrong_edition_rate": {"$ref": "#/$defs/metric"}, "citation_mismatch_rate": {"$ref": "#/$defs/metric"}, "false_complete_rate": {"$ref": "#/$defs/metric"}, "all_case_response_bytes": {"$ref": "#/$defs/bytesMetric"}, "real_document_discovery_accuracy": {"$ref": "#/$defs/notMeasuredMetric"}, "real_document_semantic_fidelity": {"$ref": "#/$defs/notMeasuredMetric"}, "tokenizer_normalized_efficiency": {"$ref": "#/$defs/notMeasuredMetric"}, "peak_process_resources": {"$ref": "#/$defs/notMeasuredMetric"}, "engineer_time_saved": {"$ref": "#/$defs/notMeasuredMetric"}}
        },
        "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}}
      }
    }
  }
}
