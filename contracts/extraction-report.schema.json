{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardsforge.dev/contracts/extraction-report.schema.json",
  "title": "StandardsForge PDF extraction report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "compiler", "document_id", "edition_id", "source_pdf", "extracted_page_records", "pages_without_text_records", "fidelity", "pages"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "pypdf_version", "extraction_mode", "rotated_text"],
      "properties": {
        "name": {"const": "standardsforge-pdf-text-layer"},
        "version": {"type": "string", "minLength": 1},
        "pypdf_version": {"type": "string", "minLength": 1},
        "extraction_mode": {"const": "layout"},
        "rotated_text": {"const": "included"}
      }
    },
    "document_id": {"type": "string", "minLength": 1},
    "edition_id": {"type": "string", "minLength": 1},
    "source_pdf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_length", "physical_pages"],
      "properties": {
        "path": {"type": "string", "pattern": "^sources/.*\\.[Pp][Dd][Ff]$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byte_length": {"type": "integer", "minimum": 1},
        "physical_pages": {"type": "integer", "minimum": 1}
      }
    },
    "extracted_page_records": {"type": "integer", "minimum": 1},
    "pages_without_text_records": {"type": "integer", "minimum": 0},
    "fidelity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text_layer", "ocr", "tables", "figures", "clause_boundaries", "obligations"],
      "properties": {
        "text_layer": {"const": "extracted_not_visually_verified"},
        "ocr": {"const": "not_used"},
        "tables": {"const": "not_interpreted"},
        "figures": {"const": "not_interpreted"},
        "clause_boundaries": {"const": "not_derived"},
        "obligations": {"const": "not_classified"}
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["physical_page", "content_stream_bytes", "text_characters", "text_sha256", "text_layer_status", "visual_fidelity", "tables", "figures", "ocr"],
        "properties": {
          "physical_page": {"type": "integer", "minimum": 1},
          "content_stream_bytes": {"type": "integer", "minimum": 0},
          "text_characters": {"type": "integer", "minimum": 0},
          "text_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "text_layer_status": {"enum": ["extracted", "no_text"]},
          "visual_fidelity": {"const": "not_verified"},
          "tables": {"const": "not_interpreted"},
          "figures": {"const": "not_interpreted"},
          "ocr": {"const": "not_used"}
        }
      }
    }
  }
}
