{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardsforge.dev/contracts/answer-suite-0.1.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite",
    "suite_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite_id",
        "author_identity",
        "frozen_at",
        "qualification",
        "cases"
      ],
      "properties": {
        "suite_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "author_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "frozen_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "qualification": {
          "const": "bounded_source_grounded_answer_quality"
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "question",
              "evidence",
              "criteria"
            ],
            "properties": {
              "case_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,256}$"
              },
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32768
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "$ref": "https://standardsforge.dev/contracts/reference-bindings-0.1.0.schema.json#/$defs/binding/properties/source"
                }
              },
              "criteria": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "criterion_id",
                    "requirement",
                    "evidence_indices"
                  ],
                  "properties": {
                    "criterion_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.:-]{1,256}$"
                    },
                    "requirement": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32768
                    },
                    "evidence_indices": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 32,
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 31
                      },
                      "uniqueItems": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "suite_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
