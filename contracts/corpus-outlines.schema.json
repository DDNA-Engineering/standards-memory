{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "source_index_sha256",
    "compiler_version",
    "classification",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "operation": {
      "const": "compile_corpus_outlines"
    },
    "source_index_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "compiler_version": {
      "type": "string"
    },
    "classification": {
      "const": "automated_unreviewed_not_semantic_qualification"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_package_digest",
          "outline_package_digest",
          "records",
          "status",
          "error"
        ],
        "properties": {
          "source_package_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "outline_package_digest": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "records": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "compiled",
              "failed"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardsforge.dev/contracts/corpus-outlines-0.1.0.schema.json",
  "title": "Corpus outline derivation index 0.1.0"
}
