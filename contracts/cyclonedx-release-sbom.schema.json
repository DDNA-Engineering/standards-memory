{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardsforge.dev/contracts/cyclonedx-release-sbom.schema.json",
  "title": "StandardsForge closed CycloneDX 1.7 release SBOM profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["bomFormat", "specVersion", "serialNumber", "version", "metadata", "components", "dependencies"],
  "$defs": {
    "hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "content"],
      "properties": {
        "alg": {"const": "SHA-256"},
        "content": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {"type": "string", "pattern": "^standardsforge:[a-z0-9-]+$"},
        "value": {"type": "string"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "bom-ref", "name", "version", "hashes", "properties"],
      "properties": {
        "type": {"enum": ["application", "library"]},
        "bom-ref": {"type": "string", "pattern": "^urn:sha256:[0-9a-f]{64}$"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "purl": {"type": "string", "pattern": "^pkg:pypi/standardsforge@"},
        "hashes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/hash"}},
        "licenses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["expression"],
            "properties": {"expression": {"const": "Apache-2.0"}}
          }
        },
        "properties": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/property"}}
      }
    }
  },
  "properties": {
    "bomFormat": {"const": "CycloneDX"},
    "specVersion": {"const": "1.7"},
    "serialNumber": {"type": "string", "pattern": "^urn:uuid:[0-9a-f-]{36}$"},
    "version": {"const": 1},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "component"],
      "properties": {
        "timestamp": {"const": "2026-01-01T00:00:00Z"},
        "component": {"$ref": "#/$defs/component"}
      }
    },
    "components": {"type": "array", "items": {"$ref": "#/$defs/component"}},
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "dependsOn"],
        "properties": {
          "ref": {"type": "string", "pattern": "^urn:sha256:[0-9a-f]{64}$"},
          "dependsOn": {"type": "array", "items": {"type": "string", "pattern": "^urn:sha256:[0-9a-f]{64}$"}}
        }
      }
    }
  }
}
