{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standards-memory.invalid/contracts/rights-0.1.0.schema.json",
  "title": "StandardsForge pack rights claim 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rights_schema_version", "content_class", "redistribution", "processing", "model_use", "statement"
  ],
  "properties": {
    "rights_schema_version": {"const": "0.1.0"},
    "content_class": {"type": "string", "minLength": 1},
    "redistribution": {"type": "string", "minLength": 1},
    "processing": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "model_use": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1}
  }
}
