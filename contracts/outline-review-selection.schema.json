{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardsforge.dev/contracts/outline-review-selection.schema.json",
  "title": "StandardsForge bounded outline review selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "shard_id", "record_ids"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "shard_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "record_ids": {
      "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
