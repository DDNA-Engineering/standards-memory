{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardsforge.dev/contracts/outline-review-shard.schema.json",
  "title": "StandardsForge exact partial outline review shard manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "state", "shard_id", "source_page_pack_digest", "outline_package_digest", "edition_id", "document_id", "source_pdf_sha256", "source_pdf_path", "candidate_count", "outline_candidate_count", "unselected_candidate_count", "unsupported_region_count", "candidates", "coverage"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "state": {"const": "proposed_unreviewed"},
    "shard_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "source_page_pack_digest": {"$ref": "#/$defs/sha256"},
    "outline_package_digest": {"$ref": "#/$defs/sha256"},
    "edition_id": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "source_pdf_sha256": {"$ref": "#/$defs/sha256"},
    "source_pdf_path": {"type": "string", "minLength": 1},
    "candidate_count": {"type": "integer", "minimum": 1, "maximum": 256},
    "outline_candidate_count": {"type": "integer", "minimum": 1},
    "unselected_candidate_count": {"type": "integer", "minimum": 0},
    "unsupported_region_count": {"type": "integer", "minimum": 0},
    "candidates": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["candidate_record_id", "candidate_logical_id", "candidate_content_sha256", "draft_sha256", "draft_path"],
        "properties": {
          "candidate_record_id": {"type": "string", "minLength": 1},
          "candidate_logical_id": {"type": "string", "minLength": 1},
          "candidate_content_sha256": {"$ref": "#/$defs/sha256"},
          "draft_sha256": {"$ref": "#/$defs/sha256"},
          "draft_path": {"type": "string", "pattern": "^drafts/[0-9a-f]{64}\\.json$"}
        }
      }
    },
    "coverage": {"const": "explicit_selected_candidates_only_not_document_complete"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
