{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardsforge.dev/contracts/source-catalog.schema.json",
  "title": "StandardsForge local source catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "title", "purpose", "selection_basis", "documents"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "catalog_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "selection_basis": {"type": "string", "minLength": 1},
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/document"}
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "document_family_id", "edition_id", "title", "publisher", "status", "revision", "change", "document_date", "distribution_statement", "detail_url", "source_origin", "local_filename", "sha256", "byte_length", "page_count", "retrieved_at", "rights"],
      "properties": {
        "document_id": {"type": "string", "minLength": 1},
        "document_family_id": {"type": "string", "minLength": 1},
        "edition_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "revision": {"type": ["string", "null"]},
        "change": {"type": "integer", "minimum": 0},
        "document_date": {"type": "string", "format": "date"},
        "distribution_statement": {"type": "string", "minLength": 1},
        "detail_url": {"type": "string", "format": "uri"},
        "source_origin": {"const": "official_dla_assist_quick_search"},
        "local_filename": {"type": "string", "pattern": "^[^/\\\\]+\\.[Pp][Dd][Ff]$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byte_length": {"type": "integer", "minimum": 1},
        "page_count": {"type": "integer", "minimum": 1},
        "retrieved_at": {"type": "string", "format": "date"},
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["access_basis", "repository_redistribution"],
          "properties": {
            "access_basis": {"type": "string", "minLength": 1},
            "repository_redistribution": {"const": "not_asserted"}
          }
        }
      }
    }
  }
}
