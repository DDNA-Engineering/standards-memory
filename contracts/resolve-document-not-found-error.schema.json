{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardsforge.dev/contracts/resolve-document-not-found-error-0.1.0.schema.json",
  "title": "StandardsForge resolve-document near-match error envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "error"],
  "properties": {
    "ok": {"const": false},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "details"],
      "properties": {
        "code": {"const": "not_found"},
        "message": {"type": "string", "minLength": 1},
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "requested", "candidates", "candidates_truncated", "discovery_operation"],
          "properties": {
            "operation": {"const": "resolve_document"},
            "requested": {
              "type": "object",
              "additionalProperties": false,
              "required": ["identifier", "normalized_identifier", "edition_id", "representation"],
              "properties": {
                "identifier": {"type": "string", "minLength": 1},
                "normalized_identifier": {"type": "string", "minLength": 1},
                "edition_id": {"type": ["string", "null"]},
                "representation": {"oneOf": [{"enum": ["page_text", "derived_structure", "reviewed_structure", "curated_records"]}, {"type": "null"}]}
              }
            },
            "candidates": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["match_basis", "document_family_id", "identifier", "normalized_identifier", "title", "edition_id", "revision", "representation", "package_digest", "resolve_selector"],
                "properties": {
                  "match_basis": {"enum": ["exact_identifier_alternate_selector", "identifier_prefix", "document_family"]},
                  "document_family_id": {"type": "string", "minLength": 1},
                  "identifier": {"type": "string", "minLength": 1},
                  "normalized_identifier": {"type": "string", "minLength": 1},
                  "title": {"type": "string", "minLength": 1},
                  "edition_id": {"type": "string", "minLength": 1},
                  "revision": {"type": "string"},
                  "representation": {"enum": ["page_text", "derived_structure", "reviewed_structure", "curated_records"]},
                  "package_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "resolve_selector": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["identifier", "edition_id", "representation"],
                    "properties": {
                      "identifier": {"type": "string", "minLength": 1},
                      "edition_id": {"type": "string", "minLength": 1},
                      "representation": {"enum": ["page_text", "derived_structure", "reviewed_structure", "curated_records"]}
                    }
                  }
                }
              }
            },
            "candidates_truncated": {"type": "boolean"},
            "discovery_operation": {"const": "list_documents"}
          }
        }
      }
    }
  }
}
