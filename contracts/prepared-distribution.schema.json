{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardsforge.dev/contracts/prepared-distribution.schema.json",
  "title": "StandardsForge prepared distribution manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "version", "build", "state", "files"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "product": {"const": "StandardsForge prepared distribution"},
    "version": {"type": "string", "minLength": 1},
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archive_source_date_epoch", "archive_timestamp", "wheel_build_backend", "wheel_generator", "wheel_sha256", "wheel_provenance_sha256", "corpus_compiler_version"],
      "properties": {
        "archive_source_date_epoch": {"const": 1767225600},
        "archive_timestamp": {"const": "2026-01-01T00:00:00Z"},
        "wheel_build_backend": {"const": "setuptools==84.0.0"},
        "wheel_generator": {"const": "setuptools (84.0.0)"},
        "wheel_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "wheel_provenance_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "corpus_compiler_version": {"type": "string", "minLength": 1}
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpus_id", "corpus_package_count", "included_package_count", "page_record_count", "source_pdf_count", "physical_page_count", "principal_id", "mil_std_810h_derived_package_digest", "source_baseline_id"],
      "properties": {
        "corpus_id": {"type": "string", "minLength": 1},
        "corpus_package_count": {"type": "integer", "minimum": 1},
        "included_package_count": {"type": "integer", "minimum": 2},
        "page_record_count": {"type": "integer", "minimum": 0},
        "source_pdf_count": {"type": "integer", "minimum": 0},
        "physical_page_count": {"type": "integer", "minimum": 0},
        "principal_id": {"const": "local-user"},
        "mil_std_810h_derived_package_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_baseline_id": {"type": "string", "minLength": 1}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
