{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardsforge.dev/contracts/answer-benchmark-run-0.1.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "run_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite",
        "submission",
        "adjudication",
        "runtime_source_sha256",
        "results",
        "metrics",
        "gate",
        "qualification",
        "limitations"
      ],
      "properties": {
        "suite": {
          "$ref": "https://standardsforge.dev/contracts/answer-suite-0.1.0.schema.json"
        },
        "submission": {
          "$ref": "https://standardsforge.dev/contracts/answer-submission-0.1.0.schema.json"
        },
        "adjudication": {
          "$ref": "https://standardsforge.dev/contracts/answer-adjudication-0.1.0.schema.json"
        },
        "runtime_source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "passed",
              "citation_coverage",
              "evidence"
            ],
            "properties": {
              "case_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,256}$"
              },
              "passed": {
                "type": "boolean"
              },
              "citation_coverage": {
                "type": "boolean"
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "$ref": "https://standardsforge.dev/contracts/query-response-0.6.0.schema.json#/$defs/getClause"
                }
              }
            }
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cases",
            "passed_cases",
            "failed_cases",
            "criteria",
            "passed_criteria",
            "failed_criteria",
            "unassessed_criteria"
          ],
          "properties": {
            "cases": {
              "type": "integer",
              "minimum": 0
            },
            "passed_cases": {
              "type": "integer",
              "minimum": 0
            },
            "failed_cases": {
              "type": "integer",
              "minimum": 0
            },
            "criteria": {
              "type": "integer",
              "minimum": 0
            },
            "passed_criteria": {
              "type": "integer",
              "minimum": 0
            },
            "failed_criteria": {
              "type": "integer",
              "minimum": 0
            },
            "unassessed_criteria": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "passed",
            "maximum_failed_cases"
          ],
          "properties": {
            "passed": {
              "type": "boolean"
            },
            "maximum_failed_cases": {
              "const": 0
            }
          }
        },
        "qualification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "separate_reviewer_claim",
            "reviewer_identity_authenticated",
            "corpus_wide_quality_established",
            "suite_freeze"
          ],
          "properties": {
            "scope": {
              "const": "bounded_source_grounded_answer_quality"
            },
            "separate_reviewer_claim": {
              "type": "boolean"
            },
            "reviewer_identity_authenticated": {
              "const": false
            },
            "corpus_wide_quality_established": {
              "const": false
            },
            "suite_freeze": {
              "const": "content_bound_without_external_timestamp"
            }
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          }
        }
      }
    },
    "run_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
