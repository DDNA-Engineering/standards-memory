{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardsforge.dev/contracts/answer-adjudication-0.1.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adjudication",
    "adjudication_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite_sha256",
        "submission_sha256",
        "reviewer",
        "case_reviews"
      ],
      "properties": {
        "suite_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "submission_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identity",
            "kind",
            "reviewed_at",
            "method",
            "independence_claim"
          ],
          "properties": {
            "identity": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            },
            "kind": {
              "enum": [
                "agent",
                "human"
              ]
            },
            "reviewed_at": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            },
            "method": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            },
            "independence_claim": {
              "enum": [
                "self_review",
                "separate_reviewer"
              ]
            }
          }
        },
        "case_reviews": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "answer_verdict",
              "rationale",
              "criteria"
            ],
            "properties": {
              "case_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,256}$"
              },
              "answer_verdict": {
                "enum": [
                  "supported",
                  "contradicted",
                  "insufficient_evidence",
                  "unable_to_assess"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32768
              },
              "criteria": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "criterion_id",
                    "verdict",
                    "rationale"
                  ],
                  "properties": {
                    "criterion_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.:-]{1,256}$"
                    },
                    "verdict": {
                      "enum": [
                        "pass",
                        "fail",
                        "unable_to_assess"
                      ]
                    },
                    "rationale": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32768
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "adjudication_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
